gunw_path in tqdm(gunw_paths):\n    output_path = f\"{gunw_path.parent}/{gunw_path.stem}_subset.h5\"\n    subset_gunw(gunw_path, output_path, subset_aoi)\n\n    gunw_path.unlink()    ","key":"fZNI4FGxgo"},{"type":"outputs","id":"3PQH2AkpdYBKrZBcz8WRe","children":[],"key":"ijwRsoKxGE"}],"identifier":"e8105f37-36e2-4807-9dd4-7a59def32047","html_id":"e8105f37-36e2-4807-9dd4-7a59def32047","key":"NHEMg7rWqI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3d. Update the bbox for the subset GUNWs","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ERSL0LH4Oa"}],"identifier":"id-3d-update-the-bbox-for-the-subset-gunws","label":"3d. Update the bbox for the subset GUNWs","html_id":"id-3d-update-the-bbox-for-the-subset-gunws","implicit":true,"key":"AJ0zeGmRev"}],"identifier":"09accb30-d05a-42a0-a967-5dc696041853","html_id":"09accb30-d05a-42a0-a967-5dc696041853","key":"jFhtDP7qZo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from shapely import wkt\nimport h5py\n\ngunw_paths = list(data_dir.glob(\"*GUNW*.h5\"))\n\nwith h5py.File(gunw_paths[0]) as f:\n    polygon = wkt.loads(f[\"/science/LSAR/identification/boundingPolygon\"][()].decode())\n\nbbox = polygon.bounds  # west, south, east, north\n\nprint(f\"bbox: {bbox}\")","key":"OYKvQvrrKz"},{"type":"outputs","id":"MqgmsqwlYZciVk5tALTGM","children":[],"key":"u2NW8VyKCo"}],"identifier":"2c8241b3-7681-4f39-909b-392ae1f80f88","html_id":"2c8241b3-7681-4f39-909b-392ae1f80f88","key":"jcBFvVq3fn"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"XtfKCifpRt"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"4. (Optional) Inspect one of the GUNWs with Xarray","position":{"start":{"line":3,