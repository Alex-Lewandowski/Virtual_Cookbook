dren":[{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Contact ASF User Support: ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"bjNumQ2Gqv"},{"type":"link","url":"mailto:uso@asf.alaska.edu","children":[{"type":"text","value":"uso@asf.alaska.edu","key":"OTiSjCCFwX"}],"urlSource":"mailto:uso@asf.alaska.edu","key":"RF9OwmOzT5"}],"key":"WNkKvIv1e3"}],"key":"tbsHgLQRKS"}],"enumerator":"2","key":"I9fACloVSS"}],"key":"O9r5GoqqvY"},{"type":"thematicBreak","key":"xVrJkwSCH5"},{"type":"heading","depth":2,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"0. Initialize the user-defined variables for this notebook","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"M19xTT88Kb"}],"identifier":"id-0-initialize-the-user-defined-variables-for-this-notebook","label":"0. Initialize the user-defined variables for this notebook","html_id":"id-0-initialize-the-user-defined-variables-for-this-notebook","implicit":true,"key":"T8x0zLiWM8"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Update the variables below to initalize your NISAR GUNW search parameters and create a directory in which to store your data.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"I0tEr3xXs0"}],"key":"NQGFIpubIr"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Use ","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"mHHlhEfuhx"},{"type":"link","url":"https://nisar-docs.asf.alaska.edu/vertex/","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Vertex","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"FqDXt5cKdv"}],"urlSource":"https://nisar-docs.asf.alaska.edu/vertex/","key":"zDLSGsU7GV"},{"type":"text","value":" to preview the data you wish to access and identify the values to use for the search parameters below.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"wQCLZKgFRa"}],"key":"D8plG9D9dn"}],"identifier":"0b1ffe80-aa7b-4696-9cb3-666766590d64-intro","html_id":"0b1ffe80-aa7b-4696-9cb3-666766590d64-intro","key":"xHRWxprwRT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from datetime import datetime\nfrom pathlib import Path\n\nstart_date = datetime(2025, 5, 22)\nend_date = datetime(2028, 12, 5)\n\n# POINT or POLYGON as WKT (well-known-text)\nsearch_aoi = \"POLYGON((-90.3933 29.1394,-89.4273 29.1394,-89.4273 30.0661,-90.3933 30.0661,-90.3933 29.1394))\" # Tip: Copy/paste WKT from a Vertex search\n\nframe = 74\nrelativeOrbit = 156\n\n# Create a directory in which to store your data \ndata_dir = Path.cwd() / \"MintPy_example_GUNW_data\"\ndata_dir.mkdir(exist_ok=True)\nprint(f'data_dir: {data_dir}')","key":"z6nXDfVv6C"},{"type":"outputs","id":"3pOAZnA0KuqRa-tjGU0G8","children":[],"key":"J533VaGOqt"}],"identifier":"b255c6ce-039e-479a-b931-d22c92538073","html_id":"b255c6ce-039e-479a-b931-d22c92538073","key":"d7QN67Wlxf"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"oPhlfmvgxs"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"1. Search and download NISAR GUNW Data","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"liptidWtPB"}],"identifier":"id-1-search-and-download-nisar-gunw-data","label":"1. Search and download NISAR GUNW Data","html_id":"id-1-search-and-download-nisar-gunw-data","implicit":true,"key":"RJN0eVsh6Z"},{"type":"heading","depth":3,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"1a. Search for NISAR GUNW data with asf_search","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"DxjYDEsOVB"}],"identifier":"id-1a-search-for-nisar-gunw-data-with-asf-search","label":"1a. Search for NISAR GUNW data with asf_search","html_id":"id-1a-search-for-nisar-gunw-data-with-asf-search","implicit":true,"key":"agSt8Ddcwd"}],"identifier":"ef9dd685-8f46-4692-9e4c-b6a248f356d0","html_id":"ef9dd685-8f46-4692-9e4c-b6a248f356d0","key":"xTGARtAMvk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import asf_search as asf\nfrom getpass import getpass\n\nsession = asf.ASFSession()\nsession.auth_with_creds(input('EDL Username'), getpass('EDL Password'))\n\nopts=asf.ASFSearchOptions(**{\n    \"maxResults\": 250,\n    \"intersectsWith\": search_aoi,\n    \"start\": start_date,\n    \"end\": end_date,\n    \"processingLevel\": [\n        \"GUNW\"\n    ],\n    \"dataset\": [\n        \"NISAR\"\n    ],\n    \"productionConfiguration\": [\n        \"PR\"\n    ],\n    \"dataMaturity\" : \"PROVISIONAL\",\n    'session': session,\n    \"frame\": frame,\n    \"relativeOrbit\": relativeOrbit,\n})\n\npattern = r'^(?!.*QA_STATS).*' # regex to remove static data files from results\nresponse = asf.search(opts=opts)\nhdf5_urls = response.find_urls(extension='.h5', pattern=pattern, directAccess=False)\nhdf5_urls","key":"BXFwNvbK6G"},{"type":"outputs","id":"reuHxFOY_7NCxi-lh2dEL","children":[],"key":"qpB0lMLTbR"}],"identifier":"ed826c44-2c86-4674-8016-23b639bb3b20","html_id":"ed826c44-2c86-4674-8016-23b639bb3b20","key":"ti273NlsjT"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1b. Retain only the latest GUNW product releases","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OSPf55Ikav"}],"identifier":"id-1b-retain-only-the-latest-gunw-product-releases","label":"1b. Retain only the latest GUNW product releases","html_id":"id-1b-retain-only-the-latest-gunw-product-releases","implicit":true,"key":"kNMN5ec1q2"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"NISAR products are occasionaly re-released using the same processor version for a variety of possible reasons. These products will maintain the same CRID and have an incremented CTR. See ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"kSZGNwqUEx"},{"type":"link","url":"https://nisar-docs.asf.alaska.edu/naming-conventions/","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"NISAR naming convention documentation","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wI7L5EXCST"}],"urlSource":"https://nisar-docs.asf.alaska.edu/naming-conventions/","key":"OVoT6khxSB"},{"type":"text","value":" for details.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"uheg4jcOHp"}],"key":"bbwWzxDIy0"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"The cell below retains only the most recent release of each NISAR GUNW.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Ut9V6AKpND"}],"key":"orL2W3Xidq"}],"identifier":"42d69c3b-5989-4afd-9ac2-fb090402fec8","html_id":"42d69c3b-5989-4afd-9ac2-fb090402fec8","key":"GyIkRvzfXg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import re\n\ndef keep_latest_gunw(urls):\n    latest = {}\n\n    for url in urls:\n        dates = re.findall(r\"\\d{8}T\\d{6}\", url)\n        pair = (dates[0][:8], dates[2][:8])\n        version = int(re.search(r\"_(\\d{3})\\.h5\", url).group(1))\n\n        if pair not in latest or version > latest[pair][0]:\n            latest[pair] = (version, url)\n\n    return [url for version, url in latest.values()]\n\nkeep_latest_gunw(hdf5_urls)","key":"aeShtdkt3F"},{"type":"outputs","id":"jIOt5XEBLOUcg9IH-kmJm","children":[],"key":"oOEpt77Qdw"}],"identifier":"b5560d1b-4916-4e76-b301-67190beb2602","html_id":"b5560d1b-4916-4e76-b301-67190beb2602","key":"sqY87nCDZE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1c. Download the NISAR GUNWs","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hHTlc5LIjk"}],"identifier":"id-1c-download-the-nisar-gunws","label":"1c. Download the NISAR GUNWs","html_id":"id-1c-download-the-nisar-gunws","implicit":true,"key":"eZI6yXIviz"}],"identifier":"a67d3e90-d423-4d74-b74d-0534f2bf2b15","html_id":"a67d3e90-d423-4d74-b74d-0534f2bf2b15","key":"BU4KIpBGvo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"asf.download_urls(hdf5_urls, data_dir, session=session)","key":"Isqn73HyQB"},{"type":"outputs","id":"9rX1847urEtrTg_UxOjXa","children":[],"key":"AFfTxehlZj"}],"identifier":"158a6928-4088-40c8-95af-7b6437efa16b","html_id":"158a6928-4088-40c8-95af-7b6437efa16b","key":"bEpk4aKir7"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"NolWmU4Hey"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"2. Identify a GUNW’s bounding box and EPSG","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"c4UhxwQGrO"}],"identifier":"id-2-identify-a-gunws-bounding-box-and-epsg","label":"2. Identify a GUNW’s bounding box and EPSG","html_id":"id-2-identify-a-gunws-bounding-box-and-epsg","implicit":true,"key":"yyUyTsg30o"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"This information will be used for subsetting and reprojecting","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"t0sU2cnJxe"}],"key":"rnz0WzI3eJ"}],"identifier":"9e067335-9a11-4cdd-8098-4978567e314c","html_id":"9e067335-9a11-4cdd-8098-4978567e314c","key":"p6L3QHy8b5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from shapely import wkt\nimport h5py\n\ngunw_paths = list(data_dir.glob(\"*GUNW*.h5\"))\n\nwith h5py.File(gunw_paths[0]) as f:\n    polygon = wkt.loads(f[\"/science/LSAR/identification/boundingPolygon\"][()].decode())\n    epsg =  f[\"/science/LSAR/GUNW/grids/frequencyA/unwrappedInterferogram/HH/projection\"][()].item()\n\nbbox = polygon.bounds  # west, south, east, north\n\nprint(f\"bbox: {bbox}\")\nprint(f\"EPSG: {epsg}\")","key":"WSjusZrj7j"},{"type":"outputs","id":"6XrZgYFZ4VtoxgpzY28ae","children":[],"key":"k7Sx9Ko0HM"}],"identifier":"a2331463-1a7e-4e7f-a00f-848cf62fd395","html_id":"a2331463-1a7e-4e7f-a00f-848cf62fd395","key":"wt1U4I8ZKK"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"ayl6iBQoZK"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"3 (Optional) Subset NISAR GUNWs to an AOI","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"w7EcIF7BkF"}],"identifier":"id-3-optional-subset-nisar-gunws-to-an-aoi","label":"3 (Optional) Subset NISAR GUNWs to an AOI","html_id":"id-3-optional-subset-nisar-gunws-to-an-aoi","implicit":true,"key":"z85SQeCnYg"},{"type":"heading","depth":3,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"3a. Identify an Area of Interest (AOI)","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"IUL8Xu1KqR"}],"identifier":"id-3a-identify-an-area-of-interest-aoi","label":"3a. Identify an Area of Interest (AOI)","html_id":"id-3a-identify-an-area-of-interest-aoi","implicit":true,"key":"sGceBrXoKC"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Use the interactive map below to generate well-known-text (WKT) of your AOI. Copy the wkt and update the area_of_interest variable in the next code cell.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"tewo8XxGeJ"}],"key":"lxZw4nL5iB"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Try refreshing the browser tab if you have issues displaying the interactive map.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"FwfDX65qjF"}],"key":"Wl6kihMlw4"}],"identifier":"c187a201-edd3-4082-8d9e-7f6319b9824d","html_id":"c187a201-edd3-4082-8d9e-7f6319b9824d","key":"K9ECqeo7lC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nimport sys\nproject_root = Path.cwd().parent\nsys.path.insert(0, str(project_root))\n\nfrom util.wkt import rectangular_aoi_select, rectangular_wkt_bounds\n\naoi_map = rectangular_aoi_select(bbox)\n\nprint(\"Click the ■ button to select an area of interest\\n\") \ndisplay(aoi_map[\"map\"])","key":"kUrNBJSoks"},{"type":"outputs","id":"r2zyqMNmFgdz5CXX8iPtQ","children":[],"key":"ROjJwrVbw3"}],"identifier":"de6f861c-7be2-4504-bbd5-cfd77027f269","html_id":"de6f861c-7be2-4504-bbd5-cfd77027f269","key":"PQqPXxqddB"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3b. Set the WKT for your subset AOI","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"A7vWaJyAyh"}],"identifier":"id-3b-set-the-wkt-for-your-subset-aoi","label":"3b. Set the WKT for your subset AOI","html_id":"id-3b-set-the-wkt-for-your-subset-aoi","implicit":true,"key":"Gla7RrNfsZ"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Replace the WKT string below with the subset AOI you created with the interactive map in Step 3a.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"agZhWNNWsS"}],"key":"m8QkifnMsz"}],"identifier":"0fc3e9ec-13ca-43be-bd4f-781b37b952a7","html_id":"0fc3e9ec-13ca-43be-bd4f-781b37b952a7","key":"yEJX1bcdOu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"subset_aoi = \"POLYGON((-91.164122 29.117675, -90.493956 29.117675, -90.493956 29.457834, -91.164122 29.457834, -91.164122 29.117675))\"","key":"erSJleeGvo"},{"type":"outputs","id":"nMsz3lCslls1LAuSREolm","children":[],"key":"npCToSlzf0"}],"identifier":"388bb843-c7b1-48d3-be85-503e008ac7cc","html_id":"388bb843-c7b1-48d3-be85-503e008ac7cc","key":"N93SWJb5t3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3c. Subset the GUNWs to your AOI and delete the unsubset data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QumjOqM5VY"}],"identifier":"id-3c-subset-the-gunws-to-your-aoi-and-delete-the-unsubset-data","label":"3c. Subset the GUNWs to your AOI and delete the unsubset data","html_id":"id-3c-subset-the-gunws-to-your-aoi-and-delete-the-unsubset-data","implicit":true,"key":"sZHXKAdL5p"}],"identifier":"dc235023-7215-43f0-a150-8bf2144b3a1a","html_id":"dc235023-7215-43f0-a150-8bf2144b3a1a","key":"hiK4CYLgAs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from osgeo import gdal\nfrom util.subset_gunw import subset_gunw\nfrom tqdm.notebook import tqdm\n\nfor gunw_path in tqdm(gunw_paths):\n    output_path = f\"{gunw_path.parent}/{gunw_path.stem}_subset.h5\"\n    subset_gunw(gunw_path, output_path, subset_aoi)\n\n    gunw_path.unlink()    ","key":"DVeC4nzT2X"},{"type":"outputs","id":"V7HaeF1EXngScsP6F74Io","children":[],"key":"PVDAyS9g3f"}],"identifier":"e8105f37-36e2-4807-9dd4-7a59def32047","html_id":"e8105f37-36e2-4807-9dd4-7a59def32047","key":"abbcTJnItO"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3d. Update the bbox for the subset GUNWs","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"S3hZ5RKorf"}],"identifier":"id-3d-update-the-bbox-for-the-subset-gunws","label":"3d. Update the bbox for the subset GUNWs","html_id":"id-3d-update-the-bbox-for-the-subset-gunws","implicit":true,"key":"xV8Jlnn0nk"}],"identifier":"09accb30-d05a-42a0-a967-5dc696041853","html_id":"09accb30-d05a-42a0-a967-5dc696041853","key":"RhWq3Wme0T"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from shapely import wkt\nimport h5py\n\ngunw_paths = list(data_dir.glob(\"*GUNW*.h5\"))\n\nwith h5py.File(gunw_paths[0]) as f:\n    polygon = wkt.loads(f[\"/science/LSAR/identification/boundingPolygon\"][()].decode())\n\nbbox = polygon.bounds  # west, south, east, north\n\nprint(f\"bbox: {bbox}\")","key":"yKXcB6sVns"},{"type":"outputs","id":"fSMJzCBX2PaQfV1-_-JrH","children":[],"key":"es1QAy608E"}],"identifier":"2c8241b3-7681-4f39-909b-392ae1f80f88","html_id":"2c8241b3-7681-4f39-909b-392ae1f80f88","key":"YqnKwPUQTi"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"GkiBqcOCaQ"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"4. (Optional) Inspect one of the GUNWs with Xarray","position":{"start":{"