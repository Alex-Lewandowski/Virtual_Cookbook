dren":[{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Contact ASF User Support: ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"wVqzBP4zOA"},{"type":"link","url":"mailto:uso@asf.alaska.edu","children":[{"type":"text","value":"uso@asf.alaska.edu","key":"kghiy38vKv"}],"urlSource":"mailto:uso@asf.alaska.edu","key":"z2WBFr7xoH"}],"key":"JEWOeCiIHC"}],"key":"WBfh2hQHwc"}],"enumerator":"2","key":"kUPXRS8MM8"}],"key":"L4kNfy0dEg"},{"type":"thematicBreak","key":"dFgKx1RT0U"},{"type":"heading","depth":2,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"0. Initialize the user-defined variables for this notebook","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"bDzTNqa9TK"}],"identifier":"id-0-initialize-the-user-defined-variables-for-this-notebook","label":"0. Initialize the user-defined variables for this notebook","html_id":"id-0-initialize-the-user-defined-variables-for-this-notebook","implicit":true,"key":"Ik48JuQVjE"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Update the variables below to initalize your NISAR GUNW search parameters and create a directory in which to store your data.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"OJX1uvtVvY"}],"key":"tLiC7elvlr"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Use ","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"zZnA5iqXJ4"},{"type":"link","url":"https://nisar-docs.asf.alaska.edu/vertex/","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Vertex","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"SMVeQWlA1S"}],"urlSource":"https://nisar-docs.asf.alaska.edu/vertex/","key":"pX5DjfLkOE"},{"type":"text","value":" to preview the data you wish to access and identify the values to use for the search parameters below.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"meS0dV9e4K"}],"key":"ElZnG1uuiQ"}],"identifier":"0b1ffe80-aa7b-4696-9cb3-666766590d64-intro","html_id":"0b1ffe80-aa7b-4696-9cb3-666766590d64-intro","key":"U0uMohVXqw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from datetime import datetime\nfrom pathlib import Path\n\nstart_date = datetime(2025, 5, 22)\nend_date = datetime(2028, 12, 5)\n\n# POINT or POLYGON as WKT (well-known-text)\nsearch_aoi = \"POLYGON((-90.3933 29.1394,-89.4273 29.1394,-89.4273 30.0661,-90.3933 30.0661,-90.3933 29.1394))\" # Tip: Copy/paste WKT from a Vertex search\n\nframe = 74\nrelativeOrbit = 156\n\n# Create a directory in which to store your data \ndata_dir = Path.cwd() / \"MintPy_example_GUNW_data\"\ndata_dir.mkdir(exist_ok=True)\nprint(f'data_dir: {data_dir}')","key":"L1xFgGnAQT"},{"type":"outputs","id":"bHsdJpK6l5YjS4-zIJZ7Y","children":[],"key":"juz3TxFDAD"}],"identifier":"b255c6ce-039e-479a-b931-d22c92538073","html_id":"b255c6ce-039e-479a-b931-d22c92538073","key":"TjJZaSU65J"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"kcCE1OVfVF"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"1. Search and download NISAR GUNW Data","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ClasbkeBHG"}],"identifier":"id-1-search-and-download-nisar-gunw-data","label":"1. Search and download NISAR GUNW Data","html_id":"id-1-search-and-download-nisar-gunw-data","implicit":true,"key":"BOgSsU6LIr"},{"type":"heading","depth":3,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"1a. Search for NISAR GUNW data with asf_search","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"jxh4gBGPDM"}],"identifier":"id-1a-search-for-nisar-gunw-data-with-asf-search","label":"1a. Search for NISAR GUNW data with asf_search","html_id":"id-1a-search-for-nisar-gunw-data-with-asf-search","implicit":true,"key":"ErPz0sjXdl"}],"identifier":"ef9dd685-8f46-4692-9e4c-b6a248f356d0","html_id":"ef9dd685-8f46-4692-9e4c-b6a248f356d0","key":"ufdUJRjgJb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import asf_search as asf\nfrom getpass import getpass\n\nsession = asf.ASFSession()\nsession.auth_with_creds(input('EDL Username'), getpass('EDL Password'))\n\nopts=asf.ASFSearchOptions(**{\n    \"maxResults\": 250,\n    \"intersectsWith\": search_aoi,\n    \"start\": start_date,\n    \"end\": end_date,\n    \"processingLevel\": [\n        \"GUNW\"\n    ],\n    \"dataset\": [\n        \"NISAR\"\n    ],\n    \"productionConfiguration\": [\n        \"PR\"\n    ],\n    \"dataMaturity\" : \"PROVISIONAL\",\n    'session': session,\n    \"frame\": frame,\n    \"relativeOrbit\": relativeOrbit,\n})\n\npattern = r'^(?!.*QA_STATS).*' # regex to remove static data files from results\nresponse = asf.search(opts=opts)\nhdf5_urls = response.find_urls(extension='.h5', pattern=pattern, directAccess=False)\nhdf5_urls","key":"wZ1ik65HQj"},{"type":"outputs","id":"_xzW2qJ08Y392qbRvi9cG","children":[],"key":"ghBsZSr3Os"}],"identifier":"ed826c44-2c86-4674-8016-23b639bb3b20","html_id":"ed826c44-2c86-4674-8016-23b639bb3b20","key":"JEMaK6KS1U"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1b. Retain only the latest GUNW product releases","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BW2NG7aJnX"}],"identifier":"id-1b-retain-only-the-latest-gunw-product-releases","label":"1b. Retain only the latest GUNW product releases","html_id":"id-1b-retain-only-the-latest-gunw-product-releases","implicit":true,"key":"j2yptNHpGo"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"NISAR products are occasionaly re-released using the same processor version for a variety of possible reasons. These products will maintain the same CRID and have an incremented CTR. See ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"x2uMZW3j06"},{"type":"link","url":"https://nisar-docs.asf.alaska.edu/naming-conventions/","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"NISAR naming convention documentation","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"szjkcAMSe3"}],"urlSource":"https://nisar-docs.asf.alaska.edu/naming-conventions/","key":"S4fxl0v2g9"},{"type":"text","value":" for details.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vciEat0LpA"}],"key":"uJ8ttGQVuw"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"The cell below retains only the most recent release of each NISAR GUNW.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"KFwK23FJEb"}],"key":"TugL17bkRX"}],"identifier":"42d69c3b-5989-4afd-9ac2-fb090402fec8","html_id":"42d69c3b-5989-4afd-9ac2-fb090402fec8","key":"frj5ofTjOv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import re\n\ndef keep_latest_gunw(urls):\n    latest = {}\n\n    for url in urls:\n        dates = re.findall(r\"\\d{8}T\\d{6}\", url)\n        pair = (dates[0][:8], dates[2][:8])\n        version = int(re.search(r\"_(\\d{3})\\.h5\", url).group(1))\n\n        if pair not in latest or version > latest[pair][0]:\n            latest[pair] = (version, url)\n\n    return [url for version, url in latest.values()]\n\nkeep_latest_gunw(hdf5_urls)","key":"yclrKQ1hEb"},{"type":"outputs","id":"A-8xLSZG2qr2xabuIXEJv","children":[],"key":"K06rSSgZwQ"}],"identifier":"b5560d1b-4916-4e76-b301-67190beb2602","html_id":"b5560d1b-4916-4e76-b301-67190beb2602","key":"LtDjrBepwX"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1c. Download the NISAR GUNWs","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UFbpM7xO7n"}],"identifier":"id-1c-download-the-nisar-gunws","label":"1c. Download the NISAR GUNWs","html_id":"id-1c-download-the-nisar-gunws","implicit":true,"key":"HXU1YvG3hk"}],"identifier":"a67d3e90-d423-4d74-b74d-0534f2bf2b15","html_id":"a67d3e90-d423-4d74-b74d-0534f2bf2b15","key":"YGTqzH7q7i"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"asf.download_urls(hdf5_urls, data_dir, session=session)","key":"f8uIRZkY08"},{"type":"outputs","id":"9gyECfDeo5ghBDyeCDBgD","children":[],"key":"Gwam5GGSMj"}],"identifier":"158a6928-4088-40c8-95af-7b6437efa16b","html_id":"158a6928-4088-40c8-95af-7b6437efa16b","key":"TaSWG388Zh"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"NHdAw3RNzT"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"2. Identify a GUNW’s bounding box and EPSG","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"t2QoaILukn"}],"identifier":"id-2-identify-a-gunws-bounding-box-and-epsg","label":"2. Identify a GUNW’s bounding box and EPSG","html_id":"id-2-identify-a-gunws-bounding-box-and-epsg","implicit":true,"key":"s4bYAr5vBd"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"This information will be used for subsetting and reprojecting","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"dlhl2v8k6j"}],"key":"fbD9m9fIjI"}],"identifier":"9e067335-9a11-4cdd-8098-4978567e314c","html_id":"9e067335-9a11-4cdd-8098-4978567e314c","key":"r3WEUC0cDG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from shapely import wkt\nimport h5py\n\ngunw_paths = list(data_dir.glob(\"*GUNW*.h5\"))\n\nwith h5py.File(gunw_paths[0]) as f:\n    polygon = wkt.loads(f[\"/science/LSAR/identification/boundingPolygon\"][()].decode())\n    epsg =  f[\"/science/LSAR/GUNW/grids/frequencyA/unwrappedInterferogram/HH/projection\"][()].item()\n\nbbox = polygon.bounds  # west, south, east, north\n\nprint(f\"bbox: {bbox}\")\nprint(f\"EPSG: {epsg}\")","key":"Dv9KQN6etG"},{"type":"outputs","id":"7gjRl9mj7sXqv-63UtJj1","children":[],"key":"lXmNrWk4k3"}],"identifier":"a2331463-1a7e-4e7f-a00f-848cf62fd395","html_id":"a2331463-1a7e-4e7f-a00f-848cf62fd395","key":"Nw9A2pPl3W"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"rWNTGM4aLd"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"3 (Optional) Subset NISAR GUNWs to an AOI","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XXzuLUAqkG"}],"identifier":"id-3-optional-subset-nisar-gunws-to-an-aoi","label":"3 (Optional) Subset NISAR GUNWs to an AOI","html_id":"id-3-optional-subset-nisar-gunws-to-an-aoi","implicit":true,"key":"oRKLk3ArjD"},{"type":"heading","depth":3,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"3a. Identify an Area of Interest (AOI)","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ZJVoV10YK7"}],"identifier":"id-3a-identify-an-area-of-interest-aoi","label":"3a. Identify an Area of Interest (AOI)","html_id":"id-3a-identify-an-area-of-interest-aoi","implicit":true,"key":"EFHC1UpMEo"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Use the interactive map below to generate well-known-text (WKT) of your AOI. Copy the wkt and update the area_of_interest variable in the next code cell.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"ZxbIHVA2bP"}],"key":"JBUzt9KY6X"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Try refreshing the browser tab if you have issues displaying the interactive map.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"ULudUSnKkN"}],"key":"oQsyMnZVO9"}],"identifier":"c187a201-edd3-4082-8d9e-7f6319b9824d","html_id":"c187a201-edd3-4082-8d9e-7f6319b9824d","key":"wkRFo6RIfy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nimport sys\nproject_root = Path.cwd().parent\nsys.path.insert(0, str(project_root))\n\nfrom util.wkt import rectangular_aoi_select, rectangular_wkt_bounds\n\naoi_map = rectangular_aoi_select(bbox)\n\nprint(\"Click the ■ button to select an area of interest\\n\") \ndisplay(aoi_map[\"map\"])","key":"mfUNhhBM01"},{"type":"outputs","id":"TA0MN3aVkkSuPYyza79Vz","children":[],"key":"PUIgHhXG3N"}],"identifier":"de6f861c-7be2-4504-bbd5-cfd77027f269","html_id":"de6f861c-7be2-4504-bbd5-cfd77027f269","key":"qZ53LJHcOV"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3b. Set the WKT for your subset AOI","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GgoAMp6lz4"}],"identifier":"id-3b-set-the-wkt-for-your-subset-aoi","label":"3b. Set the WKT for your subset AOI","html_id":"id-3b-set-the-wkt-for-your-subset-aoi","implicit":true,"key":"LmABFZxU7x"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Replace the WKT string below with the subset AOI you created with the interactive map in Step 3a.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xLVy7NsxT2"}],"key":"rBUgTBAaA7"}],"identifier":"0fc3e9ec-13ca-43be-bd4f-781b37b952a7","html_id":"0fc3e9ec-13ca-43be-bd4f-781b37b952a7","key":"a5p8yBMhFa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"subset_aoi = \"POLYGON((-91.164122 29.117675, -90.493956 29.117675, -90.493956 29.457834, -91.164122 29.457834, -91.164122 29.117675))\"","key":"t9jC0UueBh"},{"type":"outputs","id":"HIXJYcz8627j4wRruqCDR","children":[],"key":"vlY34aFUGm"}],"identifier":"388bb843-c7b1-48d3-be85-503e008ac7cc","html_id":"388bb843-c7b1-48d3-be85-503e008ac7cc","key":"zJan6nSw6l"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3c. Subset the GUNWs to your AOI and delete the unsubset data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yiyWFm8Vzy"}],"identifier":"id-3c-subset-the-gunws-to-your-aoi-and-delete-the-unsubset-data","label":"3c. Subset the GUNWs to your AOI and delete the unsubset data","html_id":"id-3c-subset-the-gunws-to-your-aoi-and-delete-the-unsubset-data","implicit":true,"key":"Eoo7QnoJIB"}],"identifier":"dc235023-7215-43f0-a150-8bf2144b3a1a","html_id":"dc235023-7215-43f0-a150-8bf2144b3a1a","key":"Hh9g1NeqSm"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from osgeo import gdal\nfrom util.subset_gunw import subset_gunw\nfrom tqdm.notebook import tqdm\n\nfor gunw_path in tqdm(gunw_paths):\n    output_path = f\"{gunw_path.parent}/{gunw_path.stem}_subset.h5\"\n    subset_gunw(gunw_path, output_path, subset_aoi)\n\n    gunw_path.unlink()    ","key":"JV4L2PaIrI"},{"type":"outputs","id":"FbTAmhpvCutoRZBVGTx0A","children":[],"key":"kgv0K2v9bv"}],"identifier":"e8105f37-36e2-4807-9dd4-7a59def32047","html_id":"e8105f37-36e2-4807-9dd4-7a59def32047","key":"bMt5uNuSmi"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3d. Update the bbox for the subset GUNWs","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MRA1YzntKX"}],"identifier":"id-3d-update-the-bbox-for-the-subset-gunws","label":"3d. Update the bbox for the subset GUNWs","html_id":"id-3d-update-the-bbox-for-the-subset-gunws","implicit":true,"key":"H5sFLZPvlk"}],"identifier":"09accb30-d05a-42a0-a967-5dc696041853","html_id":"09accb30-d05a-42a0-a967-5dc696041853","key":"qOKoPvVDSZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from shapely import wkt\nimport h5py\n\ngunw_paths = list(data_dir.glob(\"*GUNW*.h5\"))\n\nwith h5py.File(gunw_paths[0]) as f:\n    polygon = wkt.loads(f[\"/science/LSAR/identification/boundingPolygon\"][()].decode())\n\nbbox = polygon.bounds  # west, south, east, north\n\nprint(f\"bbox: {bbox}\")","key":"LL32Egfo6R"},{"type":"outputs","id":"yWsd7KvcxtclYVfZbFJOs","children":[],"key":"smyqXWykNL"}],"identifier":"2c8241b3-7681-4f39-909b-392ae1f80f88","html_id":"2c8241b3-7681-4f39-909b-392ae1f80f88","key":"uvU8F7j5NJ"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"OU9lDbtskJ"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"4. (Optional) Inspect one of the GUNWs with Xarray","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TjL5jewx7P"}],"identifier":"id-4-optional-inspect-one-of-the-gunws-with-xarray","label":"4. (Optional) Inspect one of the GUNWs with Xarray","html_id":"id-4-optional-inspect-one-of-the-gunws-with-xarray","implicit":true,"key":"dGrusm2rb6"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Xarray provides a rich interactive HTML UI for exploring HDF5 data structures in a Jupyter Notebook.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"pJS8apzPJT"}],"key":"Y1tW72KXY3"}],"identifier":"4ac08d89-b16c-4843-a748-0b48ce57d6bb","html_id":"4ac08d89-b16c-4843-a748-0b48ce57d6bb","key":"RP0j0Gehfp"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"import xarray as xr\n\ndt = xr.open_datatree(\n        open(gunw_paths[0], \"rb\"),\n        engine=\"h5netcdf\",\n        decode_timedelta=False,\n        phony_dims=\"access\",\n        chunks=\"auto\",\n)\ndisplay(dt)","key":"lpzrGh7HbY"},{"type":"outputs","id":"VLrtehtzBjZcUwEn69EzN","children":[],"key":"pxRWQlb3eI"}],"identifier":"1f5611cd-b5f8-4158-8408-b19b6a0940e4","html_id":"1f5611cd-b5f8-4158-8408-b19b6a0940e4","key":"FDCkxkMIsU"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"s94lKxD4Ub"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"5. Download and reproject the Modified Copernicus DEM for NISAR","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"QtvXcaswvc"}],"identifier":"id-5-download-and-reproject-the-modified-copernicus-dem-for-nisar","label":"5. Download and reproject the Modified Copernicus DEM for NISAR","html_id":"id-5-download-and-reproject-the-modified-copernicus-dem-for-nisar","implicit":true,"key":"WePHjWnuhz"},{"type":"heading","depth":3,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"5a. Download a subset Modified Copernicus DEM for NISAR with sardem","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"i1R5o9qX07"}],"identifier":"id-5a-download-a-subset-modified-copernicus-dem-for-nisar-with-sardem","label":"5a. Download a subset Modified Copernicus DEM for NISAR with sardem","html_id":"id-5a-download-a-subset-modified-copernicus-dem-for-nisar-with-sardem","implicit":true,"key":"YeFuSbVyC8"}],"identifier":"db659e52-0493-4feb-8e7b-cff6f5be820a","html_id":"db659e52-0493-4feb-8e7b-cff6f5be820a","key":"h8rruxgnG0"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"import sardem.dem as dem\n\ndem_4326 = data_dir / \"DEM.tif\"\n\ndem.main(\n    output_name=dem_4326,\n    bbox=bbox,\n    data_source=\"NISAR\"\n)","key":"hIjvFtyD74"},{"type":"outputs","id":"3-7G7py5pugppW_6RkIVk","children":[],"key":"LgoqldY6aW"}],"identifier":"8276aa20-2fee-4559-895b-3ee906bdaffd","html_id":"8276aa20-2fee-4559-895b-3ee906bdaffd","key":"QvljWEadzO"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5b. Reproject DEM to GUNW EPSG","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ivVUWAJ1Rc"}],"identifier":"id-5b-reproject-dem-to-gunw-epsg","label":"5b. Reproject DEM to GUNW EPSG","html_id":"id-5b-reproject-dem-to-gunw-epsg","implicit":true,"key":"ZDg7JfwDgI"}],"identifier":"096e0608-926d-49f8-9bfd-6e1a46ace39c","html_id":"096e0608-926d-49f8-9bfd-6e1a46ace39c","key":"w4BiUzQKQv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from osgeo import gdal\ngdal.UseExceptions()\n\ninput_raster = dem_4326\noutput_raster = data_dir / f\"DEM_{epsg}.tif\"\ntarget_crs = f\"EPSG:{epsg}\"\n\nwarp_options = gdal.Warp(output_raster, input_raster, dstSRS=target_crs)\nwarp_options = None\n\ndem_4326.unlink()","key":"rQY3QSWuQ1"},{"type":"outputs","id":"H0yNDlgdLP9IyyzV4w3Qv","children":[],"key":"I9aQKIiTS2"}],"identifier":"644077be-abfd-4543-a7ff-45071805bc73","html_id":"644077be-abfd-4543-a7ff-45071805bc73","key":"ZaCxAecXKi"}],"key":"eDe230udX5"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Search and Stream NISAR Data with asf_search","url":"/search-stream-nisar-asf-search","group":"Community Notebooks"}}},"domain":"http://pre.render"}