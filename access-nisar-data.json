ype":"heading","depth":3,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"5a. Download a subset Modified Copernicus DEM for NISAR with sardem","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"rRHQNwRM1h"}],"identifier":"id-5a-download-a-subset-modified-copernicus-dem-for-nisar-with-sardem","label":"5a. Download a subset Modified Copernicus DEM for NISAR with sardem","html_id":"id-5a-download-a-subset-modified-copernicus-dem-for-nisar-with-sardem","implicit":true,"key":"wToLeVE6us"}],"identifier":"db659e52-0493-4feb-8e7b-cff6f5be820a","html_id":"db659e52-0493-4feb-8e7b-cff6f5be820a","key":"Q4NMo4nniu"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"import sardem.dem as dem\n\ndem_4326 = data_dir / \"DEM.tif\"\n\ndem.main(\n    output_name=dem_4326,\n    bbox=bbox,\n    data_source=\"NISAR\"\n)","key":"iLt2hmTTKn"},{"type":"outputs","id":"-y25TWfOa1oxgHFuNFHCn","children":[],"key":"qrsuq2anwV"}],"identifier":"8276aa20-2fee-4559-895b-3ee906bdaffd","html_id":"8276aa20-2fee-4559-895b-3ee906bdaffd","key":"IA5QG2AkRF"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5b. Reproject DEM to GUNW EPSG","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VZajsR96vN"}],"identifier":"id-5b-reproject-dem-to-gunw-epsg","label":"5b. Reproject DEM to GUNW EPSG","html_id":"id-5b-reproject-dem-to-gunw-epsg","implicit":true,"key":"Qu2u54OD77"}],"identifier":"096e0608-926d-49f8-9bfd-6e1a46ace39c","html_id":"096e0608-926d-49f8-9bfd-6e1a46ace39c","key":"f6GBXP7jWa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from osgeo import gdal\ngdal.UseExceptions()\n\ninput_raster = dem_4326\noutput_raster = data_dir / f\"DEM_{epsg}.tif\"\ntarget_crs = f\"EPSG:{epsg}\"\n\nwarp_options = gdal.Warp(output_raster, input_raster, dstSRS=target_crs)\nwarp_options = None\n\ndem_4326.unlink()","key":"OXjNurBOBw"},{"type":"outputs","id":"LKN7VSli0DwVYjrBsihWm","children":[],"key":"oAE4jWGjkj"}],"identifier":"644077be-abfd-4543-a7ff-45071805bc73","html_id":"644077be-abfd-4543-a7ff-45071805bc73","key":"FVuaj79eZb"}],"key":"MpdQ7bHqKf"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Search and Stream NISAR Data with asf_search","url":"/search-stream-nisar-asf-search","group":"Community Notebooks"}}},"domain":"http://pre.render"}