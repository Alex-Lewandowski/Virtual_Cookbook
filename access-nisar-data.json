"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Contact ASF User Support: ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"jhuFkZ1CIb"},{"type":"link","url":"mailto:uso@asf.alaska.edu","children":[{"type":"text","value":"uso@asf.alaska.edu","key":"Ym793zVThp"}],"urlSource":"mailto:uso@asf.alaska.edu","key":"KGd4HSkKT1"}],"key":"PrUOudwg0b"}],"key":"A2xSY2tSM4"}],"enumerator":"2","key":"dr7CIoPeoP"}],"key":"Fw6dAJ07R1"},{"type":"thematicBreak","key":"ECEXouloQs"},{"type":"heading","depth":2,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"0. Initialize the user-defined variables for this notebook","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"kKrGafTOP4"}],"identifier":"id-0-initialize-the-user-defined-variables-for-this-notebook","label":"0. Initialize the user-defined variables for this notebook","html_id":"id-0-initialize-the-user-defined-variables-for-this-notebook","implicit":true,"key":"BSOg9oyuJH"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Update the variables below to initalize your NISAR GUNW search parameters and create a directory in which to store your data.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"CXmY7LXe2s"}],"key":"oyZSHuFn8H"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Use ","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"ThDy0U1Z9y"},{"type":"link","url":"https://nisar-docs.asf.alaska.edu/vertex/","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Vertex","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"Qrkq5zb3O9"}],"urlSource":"https://nisar-docs.asf.alaska.edu/vertex/","key":"ELt09DH9ue"},{"type":"text","value":" to preview the data you wish to access and identify the values to use for the search parameters below.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"vSnCEgs3cM"}],"key":"xsKr2cjMYi"}],"identifier":"0b1ffe80-aa7b-4696-9cb3-666766590d64-intro","html_id":"0b1ffe80-aa7b-4696-9cb3-666766590d64-intro","key":"tU3A7sVzoL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from datetime import datetime\nfrom pathlib import Path\n\nstart_date = datetime(2025, 5, 22)\nend_date = datetime(2028, 12, 5)\n\n# POINT or POLYGON as WKT (well-known-text)\nsearch_aoi = \"POLYGON((-90.3933 29.1394,-89.4273 29.1394,-89.4273 30.0661,-90.3933 30.0661,-90.3933 29.1394))\" # Tip: Copy/paste WKT from a Vertex search\n\nframe = 74\nrelativeOrbit = 156\n\n# Create a directory in which to store your data \ndata_dir = Path.cwd() / \"MintPy_example_GUNW_data\"\ndata_dir.mkdir(exist_ok=True)\nprint(f'data_dir: {data_dir}')","key":"j3BbZdoRhI"},{"type":"outputs","id":"h1d51DFheSwx1mM7U8nbX","children":[],"key":"SbMuC0B9DX"}],"identifier":"b255c6ce-039e-479a-b931-d22c92538073","html_id":"b255c6ce-039e-479a-b931-d22c92538073","key":"BKBDJPpxhO"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"SvpQTRlPt9"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"1. Search and download NISAR GUNW Data","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"BGdjUZxE2u"}],"identifier":"id-1-search-and-download-nisar-gunw-data","label":"1. Search and download NISAR GUNW Data","html_id":"id-1-search-and-download-nisar-gunw-data","implicit":true,"key":"aou88vzXIv"},{"type":"heading","depth":3,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"1a. Search for NISAR GUNW data with asf_search","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"eAgantj9vh"}],"identifier":"id-1a-search-for-nisar-gunw-data-with-asf-search","label":"1a. Search for NISAR GUNW data with asf_search","html_id":"id-1a-search-for-nisar-gunw-data-with-asf-search","implicit":true,"key":"N6p9QEXC0m"}],"identifier":"ef9dd685-8f46-4692-9e4c-b6a248f356d0","html_id":"ef9dd685-8f46-4692-9e4c-b6a248f356d0","key":"Ru4A0Ah5oQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import asf_search as asf\nfrom getpass import getpass\n\nsession = asf.ASFSession()\nsession.auth_with_creds(input('EDL Username'), getpass('EDL Password'))\n\nopts=asf.ASFSearchOptions(**{\n    \"maxResults\": 250,\n    \"intersectsWith\": search_aoi,\n    \"start\": start_date,\n    \"end\": end_date,\n    \"processingLevel\": [\n        \"GUNW\"\n    ],\n    \"dataset\": [\n        \"NISAR\"\n    ],\n    \"productionConfiguration\": [\n        \"PR\"\n    ],\n    \"dataMaturity\" : \"PROVISIONAL\",\n    'session': session,\n    \"frame\": frame,\n    \"relativeOrbit\": relativeOrbit,\n})\n\npattern = r'^(?!.*QA_STATS).*' # regex to remove static data files from results\nresponse = asf.search(opts=opts)\nhdf5_urls = response.find_urls(extension='.h5', pattern=pattern, directAccess=False)\nhdf5_urls","key":"auK3qiwqI2"},{"type":"outputs","id":"zSM4h3m59rWD-xilwVvb_","children":[],"key":"vr92hVmyII"}],"identifier":"ed826c44-2c86-4674-8016-23b639bb3b20","html_id":"ed826c44-2c86-4674-8016-23b639bb3b20","key":"xXt4RIrPE1"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1b. Retain only the latest GUNW product releases","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iKyHNDBzhf"}],"identifier":"id-1b-retain-only-the-latest-gunw-product-releases","label":"1b. Retain only the latest GUNW product releases","html_id":"id-1b-retain-only-the-latest-gunw-product-releases","implicit":true,"key":"YSl9WqeeSJ"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"NISAR products are occasionaly re-released using the same processor version for a variety of possible reasons. These products will maintain the same CRID and have an incremented CTR. See ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"O34GlrJq47"},{"type":"link","url":"https://nisar-docs.asf.alaska.edu/naming-conventions/","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"NISAR naming convention documentation","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"K1CtV2YgJ4"}],"urlSource":"https://nisar-docs.asf.alaska.edu/naming-conventions/","key":"FOK7sqOVtC"},{"type":"text","value":" for details.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"W2RPs2pvVI"}],"key":"NcrymjsNOi"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"The cell below retains only the most recent release of each NISAR GUNW.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"klhmQTIcUM"}],"key":"ubVtA7zhPD"}],"identifier":"42d69c3b-5989-4afd-9ac2-fb090402fec8","html_id":"42d69c3b-5989-4afd-9ac2-fb090402fec8","key":"teZL9hG1nO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import re\n\ndef keep_latest_gunw(urls):\n    latest = {}\n\n    for url in urls:\n        dates = re.findall(r\"\\d{8}T\\d{6}\", url)\n        pair = (dates[0][:8], dates[2][:8])\n        version = int(re.search(r\"_(\\d{3})\\.h5\", url).group(1))\n\n        if pair not in latest or version > latest[pair][0]:\n            latest[pair] = (version, url)\n\n    return [url for version, url in latest.values()]\n\nkeep_latest_gunw(hdf5_urls)","key":"EJRr5dtCa5"},{"type":"outputs","id":"qermk0cbkgYQzAmNOUr2e","children":[],"key":"yQuF9fpgoR"}],"identifier":"b5560d1b-4916-4e76-b301-67190beb2602","html_id":"b5560d1b-4916-4e76-b301-67190beb2602","key":"i6TpWStpao"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1c. Download the NISAR GUNWs","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"AM8YeIc4eU"}],"identifier":"id-1c-download-the-nisar-gunws","label":"1c. Download the NISAR GUNWs","html_id":"id-1c-download-the-nisar-gunws","implicit":true,"key":"Jux6BEI3kC"}],"identifier":"a67d3e90-d423-4d74-b74d-0534f2bf2b15","html_id":"a67d3e90-d423-4d74-b74d-0534f2bf2b15","key":"uO3cCu2z5L"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"asf.download_urls(hdf5_urls, data_dir, session=session)","key":"aOu0tTXrHJ"},{"type":"outputs","id":"yxa8_HLpgFq6qkCwFYevY","children":[],"key":"vdRnb854Se"}],"identifier":"158a6928-4088-40c8-95af-7b6437efa16b","html_id":"158a6928-4088-40c8-95af-7b6437efa16b","key":"uZ8pkLfYDp"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"F3MV06HFfx"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"2. Identify a GUNW’s bounding box and EPSG","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fonqdZKUh6"}],"identifier":"id-2-identify-a-gunws-bounding-box-and-epsg","label":"2. Identify a GUNW’s bounding box and EPSG","html_id":"id-2-identify-a-gunws-bounding-box-and-epsg","implicit":true,"key":"X94lGWDK9Q"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"This information will be used for subsetting and reprojecting","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"IEQCcP5Q3i"}],"key":"oYIeL1lsDF"}],"identifier":"9e067335-9a11-4cdd-8098-4978567e314c","html_id":"9e067335-9a11-4cdd-8098-4978567e314c","key":"NZYTlQOmDw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from shapely import wkt\nimport h5py\n\ngunw_paths = list(data_dir.glob(\"*GUNW*.h5\"))\n\nwith h5py.File(gunw_paths[0]) as f:\n    polygon = wkt.loads(f[\"/science/LSAR/identification/boundingPolygon\"][()].decode())\n    epsg =  f[\"/science/LSAR/GUNW/grids/frequencyA/unwrappedInterferogram/HH/projection\"][()].item()\n\nbbox = polygon.bounds  # west, south, east, north\n\nprint(f\"bbox: {bbox}\")\nprint(f\"EPSG: {epsg}\")","key":"fnH6XNQgQZ"},{"type":"outputs","id":"wZKzRhUPK2zCGxW-vpV-k","children":[],"key":"McRvNYwJDp"}],"identifier":"a2331463-1a7e-4e7f-a00f-848cf62fd395","html_id":"a2331463-1a7e-4e7f-a00f-848cf62fd395","key":"kvj2IUsBqY"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"GHfJ4slibq"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"3 (Optional) Subset NISAR GUNWs to an AOI","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"QnOEyYneU2"}],"identifier":"id-3-optional-subset-nisar-gunws-to-an-aoi","label":"3 (Optional) Subset NISAR GUNWs to an AOI","html_id":"id-3-optional-subset-nisar-gunws-to-an-aoi","implicit":true,"key":"YVDXCqMdOe"},{"type":"heading","depth":3,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"3a. Identify an Area of Interest (AOI)","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"JcxNodvlx3"}],"identifier":"id-3a-identify-an-area-of-interest-aoi"