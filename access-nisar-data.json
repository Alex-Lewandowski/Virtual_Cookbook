dren":[{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Contact ASF User Support: ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"yHYUxOH8ZI"},{"type":"link","url":"mailto:uso@asf.alaska.edu","children":[{"type":"text","value":"uso@asf.alaska.edu","key":"Lc6HmsTHy3"}],"urlSource":"mailto:uso@asf.alaska.edu","key":"uRfjJZi8Of"}],"key":"lsmKV73oPU"}],"key":"N6PWZpMdjJ"}],"enumerator":"2","key":"WPH49pKG5K"}],"key":"MrkWuGChN9"},{"type":"thematicBreak","key":"PzHzcwjY9W"},{"type":"heading","depth":2,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"0. Initialize the user-defined variables for this notebook","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"RgBsntZQLX"}],"identifier":"id-0-initialize-the-user-defined-variables-for-this-notebook","label":"0. Initialize the user-defined variables for this notebook","html_id":"id-0-initialize-the-user-defined-variables-for-this-notebook","implicit":true,"key":"YIlAYON0Gi"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Update the variables below to initalize your NISAR GUNW search parameters and create a directory in which to store your data.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"YnZCbnFbaB"}],"key":"ZsuZ7xxMME"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Use ","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"ZKuOe8WF0w"},{"type":"link","url":"https://nisar-docs.asf.alaska.edu/vertex/","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Vertex","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"u53OuAmfsy"}],"urlSource":"https://nisar-docs.asf.alaska.edu/vertex/","key":"y59BaabdKY"},{"type":"text","value":" to preview the data you wish to access and identify the values to use for the search parameters below.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"Xw5ON7rvSb"}],"key":"UkXO1BZabD"}],"identifier":"0b1ffe80-aa7b-4696-9cb3-666766590d64-intro","html_id":"0b1ffe80-aa7b-4696-9cb3-666766590d64-intro","key":"UGhpz6eu8l"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from datetime import datetime\nfrom pathlib import Path\n\nstart_date = datetime(2025, 5, 22)\nend_date = datetime(2028, 12, 5)\n\n# POINT or POLYGON as WKT (well-known-text)\nsearch_aoi = \"POLYGON((-90.3933 29.1394,-89.4273 29.1394,-89.4273 30.0661,-90.3933 30.0661,-90.3933 29.1394))\" # Tip: Copy/paste WKT from a Vertex search\n\nframe = 74\nrelativeOrbit = 156\n\n# Create a directory in which to store your data \ndata_dir = Path.cwd() / \"MintPy_example_GUNW_data\"\ndata_dir.mkdir(exist_ok=True)\nprint(f'data_dir: {data_dir}')","key":"JPvKxb4cHD"},{"type":"outputs","id":"NvnAAQ2cGldiPzkg5JxjB","children":[],"key":"RHLDj9l60j"}],"identifier":"b255c6ce-039e-479a-b931-d22c92538073","html_id":"b255c6ce-039e-479a-b931-d22c92538073","key":"fppO0iaP7a"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"XdVVF4NXmB"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"1. Search and download NISAR GUNW Data","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hSyjYs3lKM"}],"identifier":"id-1-search-and-download-nisar-gunw-data","label":"1. Search and download NISAR GUNW Data","html_id":"id-1-search-and-download-nisar-gunw-data","implicit":true,"key":"vZSupMaAoZ"},{"type":"heading","depth":3,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"1a. Search for NISAR GUNW data with asf_search","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"HzjYbV9QSz"}],"identifier":"id-1a-search-for-nisar-gunw-data-with-asf-search","label":"1a. Search for NISAR GUNW data with asf_search","html_id":"id-1a-search-for-nisar-gunw-data-with-asf-search","implicit":true,"key":"mIOUuxM5sH"}],"identifier":"ef9dd685-8f46-4692-9e4c-b6a248f356d0","html_id":"ef9dd685-8f46-4692-9e4c-b6a248f356d0","key":"Nmx4ii3qIl"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import asf_search as asf\nfrom getpass import getpass\n\nsession = asf.ASFSession()\nsession.auth_with_creds(input('EDL Username'), getpass('EDL Password'))\n\nopts=asf.ASFSearchOptions(**{\n    \"maxResults\": 250,\n    \"intersectsWith\": search_aoi,\n    \"start\": start_date,\n    \"end\": end_date,\n    \"processingLevel\": [\n        \"GUNW\"\n    ],\n    \"dataset\": [\n        \"NISAR\"\n    ],\n    \"productionConfiguration\": [\n        \"PR\"\n    ],\n    \"dataMaturity\" : \"PROVISIONAL\",\n    'session': session,\n    \"frame\": frame,\n    \"relativeOrbit\": relativeOrbit,\n})\n\npattern = r'^(?!.*QA_STATS).*' # regex to remove static data files from results\nresponse = asf.search(opts=opts)\nhdf5_urls = response.find_urls(extension='.h5', pattern=pattern, directAccess=False)\nhdf5_urls","key":"hBDmVTNGOY"},{"type":"outputs","id":"N7hQNeuyQUoFh1am-ZBlc","children":[],"key":"W7MDhC0mp9"}],"identifier":"ed826c44-2c86-4674-8016-23b639bb3b20","html_id":"ed826c44-2c86-4674-8016-23b639bb3b20","key":"XpOcxlWkWg"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1b. Retain only the latest GUNW product releases","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VYsqquE9nH"}],"identifier":"id-1b-retain-only-the-latest-gunw-product-releases","label":"1b. Retain only the latest GUNW product releases","html_id":"id-1b-retain-only-the-latest-gunw-product-releases","implicit":true,"key":"tRVwkYmjLj"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"NISAR products are occasionaly re-released using the same processor version for a variety of possible reasons. These products will maintain the same CRID and have an incremented CTR. See ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TfwDHmjo5Z"},{"type":"link","url":"https://nisar-docs.asf.alaska.edu/naming-conventions/","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"NISAR naming convention documentation","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"yhBzA0hNj2"}],"urlSource":"https://nisar-docs.asf.alaska.edu/naming-conventions/","key":"HoFdKoR89P"},{"type":"text","value":" for details.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"IlSXre6J3V"}],"key":"KUnedNwS0M"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"The cell below retains only the most recent release of each NISAR GUNW.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"DUG0CISxRc"}],"key":"yCDsJEH3bu"}],"identifier":"42d69c3b-5989-4afd-9ac2-fb090402fec8","html_id":"42d69c3b-5989-4afd-9ac2-fb090402fec8","key":"li3l3ALTPO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import re\n\ndef keep_latest_gunw(urls):\n    latest = {}\n\n    for url in urls:\n        dates = re.findall(r\"\\d{8}T\\d{6}\", url)\n        pair = (dates[0][:8], dates[2][:8])\n        version = int(re.search(r\"_(\\d{3})\\.h5\", url).group(1))\n\n        if pair not in latest or version > latest[pair][0]:\n            latest[pair] = (version, url)\n\n    return [url for version, url in latest.values()]\n\nkeep_latest_gunw(hdf5_urls)","key":"JwIKHDLhYE"},{"type":"outputs","id":"OBjCSKk0weQtpVXBFlzci","children":[],"key":"hqWhKNF4jW"}],"identifier":"b5560d1b-4916-4e76-b301-67190beb2602","html_id":"b5560d1b-4916-4e76-b301-67190beb2602","key":"yReiFtXSdh"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1c. Download the NISAR GUNWs","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EKTQ8cFELz"}],"identifier":"id-1c-download-the-nisar-gunws","label":"1c. Download the NISAR GUNWs","html_id":"id-1c-download-the-nisar-gunws","implicit":true,"key":"uydVP9k3ZH"}],"identifier":"a67d3e90-d423-4d74-b74d-0534f2bf2b15","html_id":"a67d3e90-d423-4d74-b74d-0534f2bf2b15","key":"C9Z8ytDdLg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"asf.download_urls(hdf5_urls, data_dir, session=session)","key":"Iz4MB09l0g"},{"type":"outputs","id":"dmziTmtw6V063zMPS93j4","children":[],"key":"GUJpEuLDSx"}],"identifier":"158a6928-4088-40c8-95af-7b6437efa16b","html_id":"158a6928-4088-40c8-95af-7b6437efa16b","key":"JTYO2FR25d"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"imPuQtt9h1"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"2. Identify a GUNW’s bounding box and EPSG","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Uj4ua3v3U7"}],"identifier":"id-2-identify-a-gunws-bounding-box-and-epsg","label":"2. Identify a GUNW’s bounding box and EPSG","html_id":"id-2-identify-a-gunws-bounding-box-and-epsg","implicit":true,"key":"XcOA07mQx5"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"This information will be used for subsetting and reprojecting","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"maNK0VPclb"}],"key":"PdL5LDBFZc"}],"identifier":"9e067335-9a11-4cdd-8098-4978567e314c","html_id":"9e067335-9a11-4cdd-8098-4978567e314c","key":"SEayMPi7I0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from shapely import wkt\nimport h5py\n\ngunw_paths = list(data_dir.glob(\"*GUNW*.h5\"))\n\nwith h5py.File(gunw_paths[0]) as f:\n    polygon = wkt.loads(f[\"/science/LSAR/identification/boundingPolygon\"][()].decode())\n    epsg =  f[\"/science/LSAR/GUNW/grids/frequencyA/unwrappedInterferogram/HH/projection\"][()].item()\n\nbbox = polygon.bounds  # west, south, east, north\n\nprint(f\"bbox: {bbox}\")\nprint(f\"EPSG: {epsg}\")","key":"YQNaGELr09"},{"type":"outputs","id":"X0hLrLbCfwwu8Jc5F7Atd","children":[],"key":"wZSAnzoHML"}],"identifier":"a2331463-1a7e-4e7f-a00f-848cf62fd395","html_id":"a2331463-1a7e-4e7f-a00f-848cf62fd395","key":"Is5MCnOJIM"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"Ofo68KtNhk"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"3 (Optional) Subset NISAR GUNWs to an AOI","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"D2bD13ErU2"}],"identifier":"id-3-optional-subset-nisar-gunws-to-an-aoi","label":"3 (Optional) Subset NISAR GUNWs to an AOI","html_id":"id-3-optional-subset-nisar-gunws-to-an-aoi","implicit":true,"key":"aFx19nSyoU"},{"type":"heading","depth":3,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"3a. Identify an Area of Interest (AOI)","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"nGpv0ZNsNs"}],"identifier":"id-3a-identify-an-area-of-interest-aoi","label":"3a. Identify an Area of Interest (AOI)","html_id":"id-3a-identify-an-area-of-interest-aoi","implicit":true,"key":"xfJEgKMNaE"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Use the interactive map below to generate well-known-text (WKT) of your AOI. Copy the wkt and update the area_of_interest variable in the next code cell.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"nNCYRjzqU1"}],"key":"OC9MFDURcZ"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Try refreshing the browser tab if you have issues displaying the interactive map.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"asEp757v71"}],"key":"GuRKQeai2X"}],"identifier":"c187a201-edd3-4082-8d9e-7f6319b9824d","html_id":"c187a201-edd3-4082-8d9e-7f6319b9824d","key":"G2UmLCKfyy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nimport sys\nproject_root = Path.cwd().parent\nsys.path.insert(0, str(project_root))\n\nfrom util.wkt import rectangular_aoi_select, rectangular_wkt_bounds\n\naoi_map = rectangular_aoi_select(bbox)\n\nprint(\"Click the ■ button to select an area of interest\\n\") \ndisplay(aoi_map[\"map\"])","key":"DRtpwHod2N"},{"type":"outputs","id":"vm96EiNO17SskmDsyvBgI","children":[],"key":"Ud0C37dkiS"}],"identifier":"de6f861c-7be2-4504-bbd5-cfd77027f269","html_id":"de6f861c-7be2-4504-bbd5-cfd77027f269","key":"JkLUj0kCey"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3b. Set the WKT for your subset AOI","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"w8rVZmTder"}],"identifier":"id-3b-set-the-wkt-for-your-subset-aoi","label":"3b. Set the WKT for your subset AOI","html_id":"id-3b-set-the-wkt-for-your-subset-aoi","implicit":true,"key":"sA7gueXdTf"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Replace the WKT string below with the subset AOI you created with the interactive map in Step 3a.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ybO0odYKWj"}],"key":"QmdoO1vrTL"}],"identifier":"0fc3e9ec-13ca-43be-bd4f-781b37b952a7","html_id":"0fc3e9ec-13ca-43be-bd4f-781b37b952a7","key":"mkJZcHjsWy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"subset_aoi = \"POLYGON((-91.164122 29.117675, -90.493956 29.117675, -90.493956 29.457834, -91.164122 29.457834, -91.164122 29.117675))\"","key":"WP736Snhuy"},{"type":"outputs","id":"Bzx88KWQ1L22DoteTm5os","children":[],"key":"NjZ6ml1gvY"}],"identifier":"388bb843-c7b1-48d3-be85-503e008ac7cc","html_id":"388bb843-c7b1-48d3-be85-503e008ac7cc","key":"FyWmPEmDTo"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3c. Subset the GUNWs to your AOI and delete the unsubset data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gJp9KUdCX9"}],"identifier":"id-3c-subset-the-gunws-to-your-aoi-and-delete-the-unsubset-data","label":"3c. Subset the GUNWs to your AOI and delete the unsubset data","html_id":"id-3c-subset-the-gunws-to-your-aoi-and-delete-the-unsubset-data","implicit":true,"key":"VvOuxBWlEb"}],"identifier":"dc235023-7215-43f0-a150-8bf2144b3a1a","html_id":"dc235023-7215-43f0-a150-8bf2144b3a1a","key":"WF6NNTi11x"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from osgeo import gdal\nfrom util.subset_gunw import subset_gunw\nfrom tqdm.notebook import tqdm\n\nfor gunw_path in tqdm(gunw_paths):\n    output_path = f\"{gunw_path.parent}/{gunw_path.stem}_subset.h5\"\n    subset_gunw(gunw_path, output_path, subset_aoi)\n\n    gunw_path.unlink()    ","key":"dPlbFNcrOt"},{"type":"outputs","id":"Oeba2G6VRI452p5J5Heo9","children":[],"key":"ROqXqCmwzR"}],"identifier":"e8105f37-36e2-4807-9dd4-7a59def32047","html_id":"e8105f37-36e2-4807-9dd4-7a59def32047","key":"NPDkILejar"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3d. Update the bbox for the subset GUNWs","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"e5lMujBr31"}],"identifier":"id-3d-update-the-bbox-for-the-subset-gunws","label":"3d. Update the bbox for the subset GUNWs","html_id":"id-3d-update-the-bbox-for-the-subset-gunws","implicit":true,"key":"wCEv16bcjV"}],"identifier":"09accb30-d05a-42a0-a967-5dc696041853","html_id":"09accb30-d05a-42a0-a967-5dc696041853","key":"kRhfdhXTOY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from shapely import wkt\nimport h5py\n\ngunw_paths = list(data_dir.glob(\"*GUNW*.h5\"))\n\nwith h5py.File(gunw_paths[0]) as f:\n    polygon = wkt.loads(f[\"/science/LSAR/identification/boundingPolygon\"][()].decode())\n\nbbox = polygon.bounds  # west, south, east, north\n\nprint(f\"bbox: {bbox}\")","key":"GKFhCHS3Js"},{"type":"outputs","id":"0melJ61eR8HSCH2E9xs51","children":[],"key":"Hdc7d0GeGX"}],"identifier":"2c8241b3-7681-4f39-909b-392ae1f80f88","html_id":"2c8241b3-7681-4f39-909b-392ae1f80f88","key":"R7iQLnBgHO"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"P4addZZJ8h"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"4. (Optional) Inspect one of the GUNWs with Xarray","position":{"start":{"