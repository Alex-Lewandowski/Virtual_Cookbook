t_logo.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Contact ASF User Support: ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"Hag9gPDTfP"},{"type":"link","url":"mailto:uso@asf.alaska.edu","children":[{"type":"text","value":"uso@asf.alaska.edu","key":"FQAehB0fiN"}],"urlSource":"mailto:uso@asf.alaska.edu","key":"wyh4dmFyu8"}],"key":"LYMN9M1z9i"}],"key":"olQhx0QmCT"}],"enumerator":"2","key":"X2kp2iHCep"}],"key":"GEdGGR8lum"},{"type":"thematicBreak","key":"cobA1LIkjj"},{"type":"heading","depth":2,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"0. Initialize the user-defined variables for this notebook","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"vFZZXeu3n6"}],"identifier":"id-0-initialize-the-user-defined-variables-for-this-notebook","label":"0. Initialize the user-defined variables for this notebook","html_id":"id-0-initialize-the-user-defined-variables-for-this-notebook","implicit":true,"key":"G6pZannbfW"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Update the variables below to initalize your NISAR GUNW search parameters and create a directory in which to store your data.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"oOKqMBE7Zs"}],"key":"U36Mpo9RXU"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Use ","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"CfkgI1OvjX"},{"type":"link","url":"https://nisar-docs.asf.alaska.edu/vertex/","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Vertex","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"WRUOQmm5Pi"}],"urlSource":"https://nisar-docs.asf.alaska.edu/vertex/","key":"eBW0T8O7hz"},{"type":"text","value":" to preview the data you wish to access and identify the values to use for the search parameters below.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"CphwFLvUKR"}],"key":"RtDaF7bbHd"}],"identifier":"0b1ffe80-aa7b-4696-9cb3-666766590d64-intro","html_id":"0b1ffe80-aa7b-4696-9cb3-666766590d64-intro","key":"uL86h9jyZx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from datetime import datetime\nfrom pathlib import Path\n\nstart_date = datetime(2025, 5, 22)\nend_date = datetime(2028, 12, 5)\n\n# POINT or POLYGON as WKT (well-known-text)\nsearch_aoi = \"POLYGON((-90.3933 29.1394,-89.4273 29.1394,-89.4273 30.0661,-90.3933 30.0661,-90.3933 29.1394))\" # Tip: Copy/paste WKT from a Vertex search\n\nframe = 74\nrelativeOrbit = 156\n\n# Create a directory in which to store your data \ndata_dir = Path.cwd() / \"MintPy_example_GUNW_data\"\ndata_dir.mkdir(exist_ok=True)\nprint(f'data_dir: {data_dir}')","key":"QxjsUbmXWU"},{"type":"outputs","id":"AOpyLlz8ga5UzDmlJMi_0","children":[],"key":"VYvYFzaEA2"}],"identifier":"b255c6ce-039e-479a-b931-d22c92538073","html_id":"b255c6ce-039e-479a-b931-d22c92538073","key":"BlDpp6NbIg"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"afbDeAJ7dg"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"1. Search and download NISAR GUNW Data","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"UPkJX4orS3"}],"identifier":"id-1-search-and-download-nisar-gunw-data","label":"1. Search and download NISAR GUNW Data","html_id":"id-1-search-and-download-nisar-gunw-data","implicit":true,"key":"sxlQx6b7pM"},{"type":"heading","depth":3,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"1a. Search for NISAR GUNW data with asf_search","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"tPGCdsPYMw"}],"identifier":"id-1a-search-for-nisar-gunw-data-with-asf-search","label":"1a. Search for NISAR GUNW data with asf_search","html_id":"id-1a-search-for-nisar-gunw-data-with-asf-search","implicit":true,"key":"rt3AXSvtK2"}],"identifier":"ef9dd685-8f46-4692-9e4c-b6a248f356d0","html_id":"ef9dd685-8f46-4692-9e4c-b6a248f356d0","key":"z5mVsDTnHP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import asf_search as asf\nfrom getpass import getpass\n\nsession = asf.ASFSession()\nsession.auth_with_creds(input('EDL Username'), getpass('EDL Password'))\n\nopts=asf.ASFSearchOptions(**{\n    \"maxResults\": 250,\n    \"intersectsWith\": search_aoi,\n    \"start\": start_date,\n    \"end\": end_date,\n    \"processingLevel\": [\n        \"GUNW\"\n    ],\n    \"dataset\": [\n        \"NISAR\"\n    ],\n    \"productionConfiguration\": [\n        \"PR\"\n    ],\n    \"dataMaturity\" : \"PROVISIONAL\",\n    'session': session,\n    \"frame\": frame,\n    \"relativeOrbit\": relativeOrbit,\n})\n\npattern = r'^(?!.*QA_STATS).*' # regex to remove static data files from results\nresponse = asf.search(opts=opts)\nhdf5_urls = response.find_urls(extension='.h5', pattern=pattern, directAccess=False)\nhdf5_urls","key":"rMfG2BS5B2"},{"type":"outputs","id":"2VLZLhLyO0LATfLrVEKsg","children":[],"key":"Z5JqtuV4qS"}],"identifier":"ed826c44-2c86-4674-8016-23b639bb3b20","html_id":"ed826c44-2c86-4674-8016-23b639bb3b20","key":"SyjZuzlI38"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1b. Retain only the latest GUNW product releases","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bimAAaauFw"}],"identifier":"id-1b-retain-only-the-latest-gunw-product-releases","label":"1b. Retain only the latest GUNW product releases","html_id":"id-1b-retain-only-the-latest-gunw-product-releases","implicit":true,"key":"CeLwqZTJa2"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"NISAR products are occasionaly re-released using the same processor version for a variety of possible reasons. These products will maintain the same CRID and have an incremented CTR. See ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"QWgsbXYiml"},{"type":"link","url":"https://nisar-docs.asf.alaska.edu/naming-conventions/","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"NISAR naming convention documentation","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"NVcvzuYfF1"}],"urlSource":"https://nisar-docs.asf.alaska.edu/naming-conventions/","key":"Q8lZS9l8Mn"},{"type":"text","value":" for details.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"U3gLMDOtGX"}],"key":"SRMxVY9PgS"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"The cell below retains only the most recent release of each NISAR GUNW.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"kEjuuSA3AY"}],"key":"YGOHU9sDop"}],"identifier":"42d69c3b-5989-4afd-9ac2-fb090402fec8","html_id":"42d69c3b-5989-4afd-9ac2-fb090402fec8","key":"tAEBP1ZT0w"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import re\n\ndef keep_latest_gunw(urls):\n    latest = {}\n\n    for url in urls:\n        dates = re.findall(r\"\\d{8}T\\d{6}\", url)\n        pair = (dates[0][:8], dates[2][:8])\n        version = int(re.search(r\"_(\\d{3})\\.h5\", url).group(1))\n\n        if pair not in latest or version > latest[pair][0]:\n            latest[pair] = (version, url)\n\n    return [url for version, url in latest.values()]\n\nkeep_latest_gunw(hdf5_urls)","key":"nn929LQ3sM"},{"type":"outputs","id":"yE1oqhyVshH_qHJSR_90E","children":[],"key":"utUEJlgruR"}],"identifier":"b5560d1b-4916-4e76-b301-67190beb2602","html_id":"b5560d1b-4916-4e76-b301-67190beb2602","key":"yRCcDub4F1"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1c. Download the NISAR GUNWs","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xZX5z1UejA"}],"identifier":"id-1c-download-the-nisar-gunws","label":"1c. Download the NISAR GUNWs","html_id":"id-1c-download-the-nisar-gunws","implicit":true,"key":"xoKUS2p2Do"}],"identifier":"a67d3e90-d423-4d74-b74d-0534f2bf2b15","html_id":"a67d3e90-d423-4d74-b74d-0534f2bf2b15","key":"cIEsZEr8Ky"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"asf.download_urls(hdf5_urls, data_dir, session=session)","key":"tfMy8UrX4s"},{"type":"outputs","id":"AlsPAcmLzj537hdu8haBn","children":[],"key":"AmSrvjWq2G"}],"identifier":"158a6928-4088-40c8-95af-7b6437efa16b","html_id":"158a6928-4088-40c8-95af-7b6437efa16b","key":"QpPAoVFKAT"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"gmSmWnbfjB"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"2. Identify a GUNW’s bounding box and EPSG","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"sxYvZge3gG"}],"identifier":"id-2-identify-a-gunws-bounding-box-and-epsg","label":"2. Identify a GUNW’s bounding box and EPSG","html_id":"id-2-identify-a-gunws-bounding-box-and-epsg","implicit":true,"key":"Q4vcYUFIK3"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"This information will be used for subsetting and reprojecting","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"DLugdR8AvF"}],"key":"NYoBTecguH"}],"identifier":"9e067335-9a11-4cdd-8098-4978567e314c","html_id":"9e067335-9a11-4cdd-8098-4978567e314c","key":"P3fGPyP6c7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from shapely import wkt\nimport h5py\n\ngunw_paths = list(data_dir.glob(\"*GUNW*.h5\"))\n\nwith h5py.File(gunw_paths[0]) as f:\n    polygon = wkt.loads(f[\"/science/LSAR/identification/boundingPolygon\"][()].decode())\n    epsg =  f[\"/science/LSAR/GUNW/grids/frequencyA/unwrappedInterferogram/HH/projection\"][()].item()\n\nbbox = polygon.bounds  # west, south, east, north\n\nprint(f\"bbox: {bbox}\")\nprint(f\"EPSG: {epsg}\")","key":"fpicEa60nF"},{"type":"outputs","id":"r0OiQODKAIY2havFAX2nB","children":[],"key":"VD3tWB5JhT"}],"identifier":"a2331463-1a7e-4e7f-a00f-848cf62fd395","html_id":"a2331463-1a7e-4e7f-a00f-848cf62fd395","key":"Dulcwrinpi"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"h1abMUwNgn"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"3 (Optional) Subset NISAR GUNWs to an AOI","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vwy2zqFpJr"}],"identifier":"id-3-optional-subset-nisar-gunws-to-an-aoi","label":"3 (Optional) Subset NISAR GUNWs to an AOI","html_id":"id-3-optional-subset-nisar-gunws-to-an-aoi","implicit":true,"key":"XoOXl1RJOK"},{"type":"heading","depth":3,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"3a. Identify an Area of Interest (AOI)","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"CMbGBOTCXn"}],"identifier":"id-3a-identify-an-area-of-interest-aoi","label":"3a. Identify an Area of Interest (AOI)","html_id":"id-3a-identify-an-area-of-interest-aoi","implicit":true,"key":"bM99yMhSGa"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Use the interactive map below to generate well-known-text (WKT) of your AOI. Copy the wkt and update the area_of_interest variable in the next code cell.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"fmxQk01SsI"}],"key":"b8rpuoRy5r"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Try refreshing the browser tab if you have issues displaying the interactive map.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"c0Enx9JZrw"}],"key":"c9bTT8fMp9"}],"identifier":"c187a201-edd3-4082-8d9e-7f6319b9824d","html_id":"c187a201-edd3-4082-8d9e-7f6319b9824d","key":"En5r7JF3FY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nimport sys\nproject_root = Path.cwd().parent\nsys.path.insert(0, str(project_root))\n\nfrom util.wkt import rectangular_aoi_select, rectangular_wkt_bounds\n\naoi_map = rectangular_aoi_select(bbox)\n\nprint(\"Click the ■ button to select an area of interest\\n\") \ndisplay(aoi_map[\"map\"])","key":"P6k7feMESb"},{"type":"outputs","id":"dw-iYtFVXOsDMYYPM2Or6","children":[],"key":"r8KbamVMPg"}],"identifier":"de6f861c-7be2-4504-bbd5-cfd77027f269","html_id":"de6f861c-7be2-4504-bbd5-cfd77027f269","key":"T7XpK1K7gx"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3b. Set the WKT for your subset AOI","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iqrXCy50qV"}],"identifier":"id-3b-set-the-wkt-for-your-subset-aoi","label":"3b. Set the WKT for your subset AOI","html_id":"id-3b-set-the-wkt-for-your-subset-aoi","implicit":true,"key":"Ab6ieOLzvM"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Replace the WKT string below with the subset AOI you created with the interactive map in Step 3a.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hlxGX4o526"}],"key":"EdQP6BXNRE"}],"identifier":"0fc3e9ec-13ca-43be-bd4f-781b37b952a7","html_id":"0fc3e9ec-13ca-43be-bd4f-781b37b952a7","key":"UGPexACfxp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"subset_aoi = \"POLYGON((-91.164122 29.117675, -90.493956 29.117675, -90.493956 29.457834, -91.164122 29.457834, -91.164122 29.117675))\"","key":"F0czn7c50Q"},{"type":"outputs","id":"z4iX382PQz5sSMOpXVbp7","children":[],"key":"t1Kcwn4U8W"}],"identifier":"388bb843-c7b1-48d3-be85-503e008ac7cc","html_id":"388bb843-c7b1-48d3-be85-503e008ac7cc","key":"fIDw47wAfE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3c. Subset the GUNWs to your AOI and delete the unsubset data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Gg52ndnFQi"}],"identifier":"id-3c-subset-the-gunws-to-your-aoi-and-delete-the-unsubset-data","label":"3c. Subset the GUNWs to your AOI and delete the unsubset data","html_id":"id-3c-subset-the-gunws-to-your-aoi-and-delete-the-unsubset-data","implicit":true,"key":"aZYKFJBo28"}],"identifier":"dc235023-7215-43f0-a150-8bf2144b3a1a","html_id":"dc235023-7215-43f0-a150-8bf2144b3a1a","key":"OO0BbD0nNV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from osgeo import gdal\nfrom util.subset_gunw import subset_gunw\nfrom tqdm.notebook import tqdm\n\nfor gunw_path in tqdm(gunw_paths):\n    output_path = f\"{gunw_path.parent}/{gunw_path.stem}_subset.h5\"\n    subset_gunw(gunw_path, output_path, subset_aoi)\n\n    gunw_path.unlink()    ","key":"ciev92fngX"},{"type":"outputs","id":"P4kfP1DXgmyY_LpuNFSVd","children":[],"key":"LMWNnLhi6Q"}],"identifier":"e8105f37-36e2-4807-9dd4-7a59def32047","html_id":"e8105f37-36e2-4807-9dd4-7a59def32047","key":"RjjcJokRQL"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3d. Update the bbox for the subset GUNWs","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SB901GaaLi"}],"identifier":"id-3d-update-the-bbox-for-the-subset-gunws","label":"3d. Update the bbox for the subset GUNWs","html_id":"id-3d-update-the-bbox-for-the-subset-gunws","implicit":true,"key":"yr3673XJDd"}],"identifier":"09accb30-d05a-42a0-a967-5dc696041853","html_id":"09accb30-d05a-42a0-a967-5dc696041853","key":"zgDX8r6YrY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from shapely import wkt\nimport h5py\n\ngunw_paths = list(data_dir.glob(\"*GUNW*.h5\"))\n\nwith h5py.File(gunw_paths[0]) as f:\n    polygon = wkt.loads(f[\"/science/LSAR/identification/boundingPolygon\"][()].decode())\n\nbbox = polygon.bounds  # west, south, east, north\n\nprint(f\"bbox: {bbox}\")","key":"koISmpaoqN"},{"type":"outputs","id":"R0lnLxnI4kqckgmIcmqyy","children":[],"key":"AIb2DbrYX8"}],"identifier":"2c8241b3-7681-4f39-909b-392ae1f80f88","html_id":"2c8241b3-7681-4f39-909b-392ae1f80f88","key":"HEJaETO8av"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"Oj98ARQt8m"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"4. (Optional) Inspect one of the GUNWs with Xarray","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XdqJFWW41Y"}],"identifier":"id-4-optional-inspect-one-of-the-gunws-with-xarray","label":"4. (Optional) Inspect one of the GUNWs with Xarray","html_id":"id-4-optional-inspect-one-of-the-gunws-with-xarray","implicit":true,"key":"ItCDwAdY9q"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Xarray provides a rich interactive HTML UI for exploring HDF5 data structures in a Jupyter Notebook.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"MlYmz1kq6F"}],"key":"x5En7O8vCx"}],"identifier":"4ac08d89-b16c-4843-a748-0b48ce57d6bb","html_id":"4ac08d89-b16c-4843-a748-0b48ce57d6bb","key":"I3L3SORIJe"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"import xarray as xr\n\ndt = xr.open_datatree(\n        open(gunw_paths[0], \"rb\"),\n        engine=\"h5netcdf\",\n        decode_timedelta=False,\n        phony_dims=\"access\",\n        chunks=\"auto\",\n)\ndisplay(dt)","key":"U7HazT00f8"},{"type":"outputs","id":"-GaBSl7U0dthvsblAY3A_","children":[],"key":"XAIYQwrUFR"}],"identifier":"1f5611cd-b5f8-4158-8408-b19b6a0940e4","html_id":"1f5611cd-b5f8-4158-8408-b19b6a0940e4","key":"gxiLPesj6s"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","key":"gBRX4mVAAP"},{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"5. Download and reproject the Modified Copernicus DEM for NISAR","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GrMN6rGxe5"}],"identifier":"id-5-download-and-reproject-the-modified-copernicus-dem-for-nisar","label":"5. Download and reproject the Modified Copernicus DEM for NISAR","html_id":"id-5-download-and-reproject-the-modified-copernicus-dem-for-nisar","implicit":true,"key":"ZF1QyttPRa"},{"type":"heading","depth":3,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"5a. Download a subset Modified Copernicus DEM for NISAR with sardem","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"qT507j9OK9"}],"identifier":"id-5a-download-a-subset-modified-copernicus-dem-for-nisar-with-sardem","label":"5a. Download a subset Modified Copernicus DEM for NISAR with sardem","html_id":"id-5a-download-a-subset-modified-copernicus-dem-for-nisar-with-sardem","implicit":true,"key":"SsOsHgVFnK"}],"identifier":"db659e52-0493-4feb-8e7b-cff6f5be820a","html_id":"db659e52-0493-4feb-8e7b-cff6f5be820a","key":"CcSRIYZIE0"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"import sardem.dem as dem\n\ndem_4326 = data_dir / \"DEM.tif\"\n\ndem.main(\n    output_name=dem_4326,\n    bbox=bbox,\n    data_source=\"NISAR\"\n)","key":"wWdu99UBIi"},{"type":"outputs","id":"ApXv9RI5_iqAiHVAO7faN","children":[],"key":"IJxxGFtzr9"}],"identifier":"8276aa20-2fee-4559-895b-3ee906bdaffd","html_id":"8276aa20-2fee-4559-895b-3ee906bdaffd","key":"ZWfgZdrzl9"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5b. Reproject DEM to GUNW EPSG","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"w5WzOw6Y0x"}],"identifier":"id-5b-reproject-dem-to-gunw-epsg","label":"5b. Reproject DEM to GUNW EPSG","html_id":"id-5b-reproject-dem-to-gunw-epsg","implicit":true,"key":"Ieyip3DZND"}],"identifier":"096e0608-926d-49f8-9bfd-6e1a46ace39c","html_id":"096e0608-926d-49f8-9bfd-6e1a46ace39c","key":"j3yL4TqJd3"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from osgeo import gdal\ngdal.UseExceptions()\n\ninput_raster = dem_4326\noutput_raster = data_dir / f\"DEM_{epsg}.tif\"\ntarget_crs = f\"EPSG:{epsg}\"\n\nwarp_options = gdal.Warp(output_raster, input_raster, dstSRS=target_crs)\nwarp_options = None\n\ndem_4326.unlink()","key":"tXtn2tvOb6"},{"type":"outputs","id":"ud-o0MGrmeIaToZ5FS7Ct","children":[],"key":"pB3vinlZWY"}],"identifier":"644077be-abfd-4543-a7ff-45071805bc73","html_id":"644077be-abfd-4543-a7ff-45071805bc73","key":"LQnlRCt9J0"}],"key":"tJIK7X2VOD"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Search and Stream NISAR Data with asf_search","url":"/search-stream-nisar-asf-search","group":"Community Notebooks"}}},"domain":"http://localhost:3000"}